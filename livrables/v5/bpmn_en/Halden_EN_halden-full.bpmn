<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_halden-full" targetNamespace="https://halden.example/bpmn" exporter="Halden" exporterVersion="1.0">
<bpmn:collaboration id="Collab_halden-full">
<bpmn:participant id="B_src" name="Sources: buyers, site, bank, developer"/>
<bpmn:participant id="B_out" name="Buyers and third parties (outgoing messages)"/>
<bpmn:participant id="P_hal" name="Halden" processRef="Proc_P_hal"/>
<bpmn:participant id="P_prom" name="Developer" processRef="Proc_P_prom"/>
<bpmn:messageFlow id="M_B_src_E1" name="Events" sourceRef="B_src" targetRef="E1"/>
<bpmn:messageFlow id="M_E8_H0" name="Request" sourceRef="E8" targetRef="H0"/>
<bpmn:messageFlow id="M_H1_E9" name="Decision" sourceRef="H1" targetRef="E9"/>
<bpmn:messageFlow id="M_E11_B_out" name="Approved message" sourceRef="E11" targetRef="B_out"/>
<bpmn:messageFlow id="M_T2_H3" name="Summary" sourceRef="T2" targetRef="H3"/>
</bpmn:collaboration>
<bpmn:process id="Proc_P_hal" isExecutable="false">
<bpmn:laneSet id="LS_P_hal">
<bpmn:lane id="L_can" name="Channels">
<bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E11</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_ag" name="Agents">
<bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_gf" name="Guardrails">
<bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E8</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E9</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E10</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E12</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E13</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E14</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_db" name="Data layer">
<bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="E1" name="An event arrives: message, milestone, transfer, claim"><bpmn:outgoing>F_E1_E2</bpmn:outgoing><bpmn:messageEventDefinition id="ED_E1"/></bpmn:startEvent>
<bpmn:serviceTask id="E2" name="Normalise, link to the buyer and project"><bpmn:incoming>F_E1_E2</bpmn:incoming><bpmn:outgoing>F_E2_E3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="E3" name="Route to the right agent"><bpmn:incoming>F_E2_E3</bpmn:incoming><bpmn:outgoing>F_E3_E4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="E4" name="One of the 6 agents prepares the action"><bpmn:incoming>F_E3_E4</bpmn:incoming><bpmn:outgoing>F_E4_E5</bpmn:outgoing><bpmn:property id="Prop_D_D1_E4" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="D_D1_E4"><bpmn:sourceRef>D1</bpmn:sourceRef><bpmn:targetRef>Prop_D_D1_E4</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:dataStoreReference id="D1" name="Shared memory: one file per buyer"/>
<bpmn:businessRuleTask id="E5" name="Check against the country pack (caps, deadlines)"><bpmn:incoming>F_E4_E5</bpmn:incoming><bpmn:outgoing>F_E5_E6</bpmn:outgoing><bpmn:property id="Prop_D_D2_E5" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="D_D2_E5"><bpmn:sourceRef>D2</bpmn:sourceRef><bpmn:targetRef>Prop_D_D2_E5</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:businessRuleTask>
<bpmn:dataStoreReference id="D2" name="Country packs, approved by a lawyer"/>
<bpmn:exclusiveGateway id="E6" name="Money, legal or anomaly?"><bpmn:incoming>F_E5_E6</bpmn:incoming><bpmn:outgoing>F_E6_E7</bpmn:outgoing><bpmn:outgoing>F_E6_E8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="E7" name="Run straight away: update, reminder, answer"><bpmn:incoming>F_E6_E7</bpmn:incoming><bpmn:outgoing>F_E7_E13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:sendTask id="E8" name="Place in the approval queue"><bpmn:incoming>F_E6_E8</bpmn:incoming><bpmn:outgoing>F_E8_E9</bpmn:outgoing></bpmn:sendTask>
<bpmn:intermediateCatchEvent id="E9" name="Decision received"><bpmn:incoming>F_E8_E9</bpmn:incoming><bpmn:outgoing>F_E9_E10</bpmn:outgoing><bpmn:messageEventDefinition id="ED_E9"/></bpmn:intermediateCatchEvent>
<bpmn:exclusiveGateway id="E10" name="Approved?"><bpmn:incoming>F_E9_E10</bpmn:incoming><bpmn:outgoing>F_E10_E11</bpmn:outgoing><bpmn:outgoing>F_E10_E12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:sendTask id="E11" name="Send on behalf of the developer (email, WhatsApp)"><bpmn:incoming>F_E10_E11</bpmn:incoming><bpmn:outgoing>F_E11_E13</bpmn:outgoing></bpmn:sendTask>
<bpmn:serviceTask id="E12" name="Close or rework the request"><bpmn:incoming>F_E10_E12</bpmn:incoming><bpmn:outgoing>F_E12_E13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="E13" name="Log: who, what, when, why"><bpmn:incoming>F_E7_E13</bpmn:incoming><bpmn:incoming>F_E12_E13</bpmn:incoming><bpmn:incoming>F_E11_E13</bpmn:incoming><bpmn:outgoing>F_E13_E14</bpmn:outgoing><bpmn:dataOutputAssociation id="D_E13_D3"><bpmn:targetRef>D3</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:dataStoreReference id="D3" name="Audit log"/>
<bpmn:endEvent id="E14" name="Action logged"><bpmn:incoming>F_E13_E14</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="T1" name="Every morning"><bpmn:outgoing>F_T1_T2</bpmn:outgoing><bpmn:timerEventDefinition id="ED_T1"/></bpmn:startEvent>
<bpmn:serviceTask id="T2" name="Compose the control-tower summary"><bpmn:incoming>F_T1_T2</bpmn:incoming><bpmn:outgoing>F_T2_T3</bpmn:outgoing><bpmn:property id="Prop_D_D3_T2" name="__targetRef_placeholder"/><bpmn:dataInputAssociation id="D_D3_T2"><bpmn:sourceRef>D3</bpmn:sourceRef><bpmn:targetRef>Prop_D_D3_T2</bpmn:targetRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="T3" name="Summary sent"><bpmn:incoming>F_T2_T3</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F_E1_E2" sourceRef="E1" targetRef="E2"/>
<bpmn:sequenceFlow id="F_E2_E3" sourceRef="E2" targetRef="E3"/>
<bpmn:sequenceFlow id="F_E3_E4" sourceRef="E3" targetRef="E4"/>
<bpmn:sequenceFlow id="F_E4_E5" sourceRef="E4" targetRef="E5"/>
<bpmn:sequenceFlow id="F_E5_E6" sourceRef="E5" targetRef="E6"/>
<bpmn:sequenceFlow id="F_E6_E7" name="no" sourceRef="E6" targetRef="E7"/>
<bpmn:sequenceFlow id="F_E6_E8" name="yes" sourceRef="E6" targetRef="E8"/>
<bpmn:sequenceFlow id="F_E8_E9" sourceRef="E8" targetRef="E9"/>
<bpmn:sequenceFlow id="F_E9_E10" sourceRef="E9" targetRef="E10"/>
<bpmn:sequenceFlow id="F_E10_E11" name="yes" sourceRef="E10" targetRef="E11"/>
<bpmn:sequenceFlow id="F_E10_E12" name="no" sourceRef="E10" targetRef="E12"/>
<bpmn:sequenceFlow id="F_E7_E13" sourceRef="E7" targetRef="E13"/>
<bpmn:sequenceFlow id="F_E12_E13" sourceRef="E12" targetRef="E13"/>
<bpmn:sequenceFlow id="F_E11_E13" sourceRef="E11" targetRef="E13"/>
<bpmn:sequenceFlow id="F_E13_E14" sourceRef="E13" targetRef="E14"/>
<bpmn:sequenceFlow id="F_T1_T2" sourceRef="T1" targetRef="T2"/>
<bpmn:sequenceFlow id="F_T2_T3" sourceRef="T2" targetRef="T3"/>
</bpmn:process>
<bpmn:process id="Proc_P_prom" isExecutable="false">
<bpmn:laneSet id="LS_P_prom">
<bpmn:lane id="L_eq" name="Team · approval queue">
<bpmn:flowNodeRef>H0</bpmn:flowNodeRef>
<bpmn:flowNodeRef>H1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>H2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_dir" name="Management · control tower">
<bpmn:flowNodeRef>H3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>H4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>H5</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="H0" name="Request queued"><bpmn:outgoing>F_H0_H1</bpmn:outgoing><bpmn:messageEventDefinition id="ED_H0"/></bpmn:startEvent>
<bpmn:userTask id="H1" name="Approve, sign or decide"><bpmn:incoming>F_H0_H1</bpmn:incoming><bpmn:outgoing>F_H1_H2</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="H2" name="Decision made"><bpmn:incoming>F_H1_H2</bpmn:incoming></bpmn:endEvent>
<bpmn:startEvent id="H3" name="Morning summary received"><bpmn:outgoing>F_H3_H4</bpmn:outgoing><bpmn:messageEventDefinition id="ED_H3"/></bpmn:startEvent>
<bpmn:userTask id="H4" name="Read the control tower: cash, late payers, site, defects, claims"><bpmn:incoming>F_H3_H4</bpmn:incoming><bpmn:outgoing>F_H4_H5</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="H5" name="Today's priorities"><bpmn:incoming>F_H4_H5</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F_H0_H1" sourceRef="H0" targetRef="H1"/>
<bpmn:sequenceFlow id="F_H1_H2" sourceRef="H1" targetRef="H2"/>
<bpmn:sequenceFlow id="F_H3_H4" sourceRef="H3" targetRef="H4"/>
<bpmn:sequenceFlow id="F_H4_H5" sourceRef="H4" targetRef="H5"/>
</bpmn:process>
