<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_tobe-full" targetNamespace="https://halden.example/bpmn" exporter="Halden" exporterVersion="1.0">
<bpmn:category id="Cat_G1"><bpmn:categoryValue id="CV_G1" value="1 · Reserve · month 0"/></bpmn:category>
<bpmn:category id="Cat_G2"><bpmn:categoryValue id="CV_G2" value="2 · Contract and registration · months 0–2"/></bpmn:category>
<bpmn:category id="Cat_G3"><bpmn:categoryValue id="CV_G3" value="3 and 4 · Payments and construction · months 1–30"/></bpmn:category>
<bpmn:category id="Cat_G4"><bpmn:categoryValue id="CV_G4" value="5 · Handover and defects · around month 30"/></bpmn:category>
<bpmn:category id="Cat_G5"><bpmn:categoryValue id="CV_G5" value="6 · Warranty · years 1–10"/></bpmn:category>
<bpmn:collaboration id="Collab_tobe-full">
<bpmn:participant id="B_ach" name="Buyers (300 per tower)"/>
<bpmn:participant id="P_prom" name="Developer" processRef="Proc_P_prom"/>
<bpmn:participant id="B_reg" name="Land registry (DLD, Oqood)"/>
<bpmn:participant id="B_bank" name="Escrow bank"/>
<bpmn:participant id="B_ent" name="Contractors"/>
<bpmn:participant id="B_ass" name="Insurers"/>
<bpmn:messageFlow id="M_B_ach_A1" name="Website, WhatsApp, broker" sourceRef="B_ach" targetRef="A1"/>
<bpmn:messageFlow id="M_A2_B_ach" name="Reply" sourceRef="A2" targetRef="B_ach"/>
<bpmn:messageFlow id="M_H2_B_reg" name="Deed, Oqood" sourceRef="H2" targetRef="B_reg"/>
<bpmn:messageFlow id="M_A5_B_ach" name="Payment requests" sourceRef="A5" targetRef="B_ach"/>
<bpmn:messageFlow id="M_B_bank_A5" name="Statements" sourceRef="B_bank" targetRef="A5"/>
<bpmn:messageFlow id="M_A6_B_ach" name="Updates" sourceRef="A6" targetRef="B_ach"/>
<bpmn:messageFlow id="M_A6_B_ent" name="Quotes" sourceRef="A6" targetRef="B_ent"/>
<bpmn:messageFlow id="M_A7_B_ach" name="Visits" sourceRef="A7" targetRef="B_ach"/>
<bpmn:messageFlow id="M_A8_B_ent" name="Defects" sourceRef="A8" targetRef="B_ent"/>
<bpmn:messageFlow id="M_B_ach_A9" name="Report" sourceRef="B_ach" targetRef="A9"/>
<bpmn:messageFlow id="M_A11_B_ass" name="File" sourceRef="A11" targetRef="B_ass"/>
<bpmn:group id="G1" categoryValueRef="CV_G1"/>
<bpmn:group id="G2" categoryValueRef="CV_G2"/>
<bpmn:group id="G3" categoryValueRef="CV_G3"/>
<bpmn:group id="G4" categoryValueRef="CV_G4"/>
<bpmn:group id="G5" categoryValueRef="CV_G5"/>
</bpmn:collaboration>
<bpmn:process id="Proc_P_prom" isExecutable="false">
<bpmn:laneSet id="LS_P_prom">
<bpmn:lane id="L_ag" name="AI agents">
<bpmn:flowNodeRef>A1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A7</bpmn:flowNodeRef>
<bpmn:flowNodeRef>A8</bpmn:flowNodeRef>





</bpmn:lane>
<bpmn:lane id="L_eq" name="Developer team">
<bpmn:flowNodeRef>H1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>H2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>H3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>H4</bpmn:flowNodeRef><bpmn:flowNodeRef>E4</bpmn:flowNodeRef><bpmn:flowNodeRef>WSP</bpmn:flowNodeRef>

</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="A1" name="Buyer enquiry, day or night, in any language"><bpmn:outgoing>F_A1_A2</bpmn:outgoing><bpmn:messageEventDefinition id="ED_A1"/></bpmn:startEvent>
<bpmn:serviceTask id="A2" name="Sales agent: answer from real project data"><bpmn:incoming>F_A1_A2</bpmn:incoming><bpmn:outgoing>F_A2_A3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="A3" name="Hold the unit, collect ID and deposit"><bpmn:incoming>F_A2_A3</bpmn:incoming><bpmn:outgoing>F_A3_H1</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="H1" name="Approve discounts, sign the reservation"><bpmn:incoming>F_A3_H1</bpmn:incoming><bpmn:outgoing>F_H1_A4</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="A4" name="Contract agent: fill the contract, check every document"><bpmn:incoming>F_H1_A4</bpmn:incoming><bpmn:outgoing>F_A4_H2</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="H2" name="Legal review, signing, Oqood registration with the DLD"><bpmn:incoming>F_A4_H2</bpmn:incoming><bpmn:outgoing>F_H2_g1</bpmn:outgoing></bpmn:userTask>
<bpmn:parallelGateway id="g1" name=""><bpmn:incoming>F_H2_g1</bpmn:incoming><bpmn:outgoing>F_g1_A5</bpmn:outgoing><bpmn:outgoing>F_g1_A6</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:callActivity id="A5" name="Collections agent: one cycle per milestone, up to escrow release (see zoom)"><bpmn:incoming>F_g1_A5</bpmn:incoming><bpmn:outgoing>F_A5_g2</bpmn:outgoing><bpmn:standardLoopCharacteristics id="LP_A5"/></bpmn:callActivity>
<bpmn:serviceTask id="A6" name="Buyer-care agent: updates, change requests"><bpmn:incoming>F_g1_A6</bpmn:incoming><bpmn:outgoing>F_A6_H3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="H3" name="Decide which changes, and at what price"><bpmn:incoming>F_A6_H3</bpmn:incoming><bpmn:outgoing>F_H3_g2</bpmn:outgoing></bpmn:userTask>
<bpmn:parallelGateway id="g2" name=""><bpmn:incoming>F_A5_g2</bpmn:incoming><bpmn:incoming>F_H3_g2</bpmn:incoming><bpmn:outgoing>F_g2_A7</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:serviceTask id="A7" name="Handover agent: visits, every defect with photo and location"><bpmn:incoming>F_g2_A7</bpmn:incoming><bpmn:outgoing>F_A7_A8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="A8" name="Send to the contractor, chase until fixed"><bpmn:incoming>F_A7_A8</bpmn:incoming><bpmn:outgoing>F_A8_H4</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="H4" name="Sign the handover report, decide disputed defects"><bpmn:incoming>F_A8_H4</bpmn:incoming><bpmn:outgoing>F_H4_E4</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="E4" name="Handover signed"><bpmn:incoming>F_H4_E4</bpmn:incoming></bpmn:endEvent>

<bpmn:sequenceFlow id="F_A1_A2" sourceRef="A1" targetRef="A2"/>
<bpmn:sequenceFlow id="F_A2_A3" sourceRef="A2" targetRef="A3"/>
<bpmn:sequenceFlow id="F_A3_H1" sourceRef="A3" targetRef="H1"/>
<bpmn:sequenceFlow id="F_H1_A4" sourceRef="H1" targetRef="A4"/>
<bpmn:sequenceFlow id="F_A4_H2" sourceRef="A4" targetRef="H2"/>
<bpmn:sequenceFlow id="F_H2_g1" sourceRef="H2" targetRef="g1"/>
<bpmn:sequenceFlow id="F_g1_A5" sourceRef="g1" targetRef="A5"/>
<bpmn:sequenceFlow id="F_g1_A6" sourceRef="g1" targetRef="A6"/>
<bpmn:sequenceFlow id="F_A5_g2" sourceRef="A5" targetRef="g2"/>
<bpmn:sequenceFlow id="F_A6_H3" sourceRef="A6" targetRef="H3"/>
<bpmn:sequenceFlow id="F_H3_g2" sourceRef="H3" targetRef="g2"/>
<bpmn:sequenceFlow id="F_g2_A7" sourceRef="g2" targetRef="A7"/>
<bpmn:sequenceFlow id="F_A7_A8" sourceRef="A7" targetRef="A8"/>
<bpmn:sequenceFlow id="F_A8_H4" sourceRef="A8" targetRef="H4"/>
<bpmn:sequenceFlow id="F_H4_E4" sourceRef="H4" targetRef="E4"/>
<bpmn:subProcess id="WSP" name="Warranty claims, years 1–10" triggeredByEvent="true">
<bpmn:startEvent id="A9" name="Claim reported (years 1–10)" isInterrupting="false"><bpmn:outgoing>F_A9_A10</bpmn:outgoing><bpmn:messageEventDefinition id="ED_A9"/></bpmn:startEvent>
<bpmn:serviceTask id="A10" name="Warranty agent: check the warranty, open the claim"><bpmn:incoming>F_A9_A10</bpmn:incoming><bpmn:outgoing>F_A10_g3</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="g3" name="Serious claim?"><bpmn:incoming>F_A10_g3</bpmn:incoming><bpmn:outgoing>F_g3_A11</bpmn:outgoing><bpmn:outgoing>F_g3_H5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="H5" name="Decide liability"><bpmn:incoming>F_g3_H5</bpmn:incoming><bpmn:outgoing>F_H5_A11</bpmn:outgoing></bpmn:userTask>
<bpmn:serviceTask id="A11" name="Follow up with contractor or insurer until closed"><bpmn:incoming>F_g3_A11</bpmn:incoming><bpmn:incoming>F_H5_A11</bpmn:incoming><bpmn:outgoing>F_A11_A12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="A12" name="Claim closed, full history"><bpmn:incoming>F_A11_A12</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F_A9_A10" sourceRef="A9" targetRef="A10"/>
<bpmn:sequenceFlow id="F_A10_g3" sourceRef="A10" targetRef="g3"/>
<bpmn:sequenceFlow id="F_g3_A11" name="no" sourceRef="g3" targetRef="A11"/>
<bpmn:sequenceFlow id="F_g3_H5" name="yes" sourceRef="g3" targetRef="H5"/>
<bpmn:sequenceFlow id="F_H5_A11" sourceRef="H5" targetRef="A11"/>
<bpmn:sequenceFlow id="F_A11_A12" sourceRef="A11" targetRef="A12"/>
</bpmn:subProcess>
</bpmn:process>
