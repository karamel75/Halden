<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Defs_asis-full" targetNamespace="https://halden.example/bpmn" exporter="Halden" exporterVersion="1.0">
<bpmn:category id="Cat_G1"><bpmn:categoryValue id="CV_G1" value="1 · Reserve · month 0"/></bpmn:category>
<bpmn:category id="Cat_G2"><bpmn:categoryValue id="CV_G2" value="2 · Contract and registration · months 0–2"/></bpmn:category>
<bpmn:category id="Cat_G3"><bpmn:categoryValue id="CV_G3" value="3 and 4 · Payments and construction · months 1–30"/></bpmn:category>
<bpmn:category id="Cat_G4"><bpmn:categoryValue id="CV_G4" value="5 · Handover and defects · around month 30"/></bpmn:category>
<bpmn:category id="Cat_G5"><bpmn:categoryValue id="CV_G5" value="6 · Warranty · years 1–10"/></bpmn:category>
<bpmn:collaboration id="Collab_asis-full">
<bpmn:participant id="B_ach" name="Buyers (300 per tower)"/>
<bpmn:participant id="P_prom" name="Developer" processRef="Proc_P_prom"/>
<bpmn:participant id="B_reg" name="Notary or land registry"/>
<bpmn:participant id="B_bank" name="Escrow bank"/>
<bpmn:participant id="B_ent" name="Contractors"/>
<bpmn:participant id="B_ass" name="Insurers"/>
<bpmn:messageFlow id="M_B_ach_s1" name="Website, WhatsApp, broker" sourceRef="B_ach" targetRef="s1"/>
<bpmn:messageFlow id="M_s2_B_ach" name="Reply" sourceRef="s2" targetRef="B_ach"/>
<bpmn:messageFlow id="M_j2_B_ach" name="Documents" sourceRef="j2" targetRef="B_ach"/>
<bpmn:messageFlow id="M_j3_B_reg" name="Deed, Oqood" sourceRef="j3" targetRef="B_reg"/>
<bpmn:messageFlow id="M_f1_B_ach" name="Payment requests" sourceRef="f1" targetRef="B_ach"/>
<bpmn:messageFlow id="M_B_bank_f1" name="Statements" sourceRef="B_bank" targetRef="f1"/>
<bpmn:messageFlow id="M_rc1_B_ach" name="Updates" sourceRef="rc1" targetRef="B_ach"/>
<bpmn:messageFlow id="M_rc2_B_ent" name="Quotes" sourceRef="rc2" targetRef="B_ent"/>
<bpmn:messageFlow id="M_t1_B_ach" name="Visits" sourceRef="t1" targetRef="B_ach"/>
<bpmn:messageFlow id="M_t3_B_ent" name="Defects" sourceRef="t3" targetRef="B_ent"/>
<bpmn:messageFlow id="M_B_ach_t4" name="Report" sourceRef="B_ach" targetRef="t4"/>
<bpmn:messageFlow id="M_t6_B_ass" name="File" sourceRef="t6" targetRef="B_ass"/>
<bpmn:group id="G1" categoryValueRef="CV_G1"/>
<bpmn:group id="G2" categoryValueRef="CV_G2"/>
<bpmn:group id="G3" categoryValueRef="CV_G3"/>
<bpmn:group id="G4" categoryValueRef="CV_G4"/>
<bpmn:group id="G5" categoryValueRef="CV_G5"/>
</bpmn:collaboration>
<bpmn:process id="Proc_P_prom" isExecutable="false">
<bpmn:laneSet id="LS_P_prom">
<bpmn:lane id="L_v" name="Sales">
<bpmn:flowNodeRef>s1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>s3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_j" name="Legal">
<bpmn:flowNodeRef>j1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>j2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>j3</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_f" name="Finance">
<bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>f1</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_rc" name="Customer relations">
<bpmn:flowNodeRef>rc1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>rc2</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_t" name="Technical and after-sales">
<bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
<bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="s1" name="Buyer enquiry"><bpmn:outgoing>F_s1_s2</bpmn:outgoing><bpmn:messageEventDefinition id="ED_s1"/></bpmn:startEvent>
<bpmn:manualTask id="s2" name="Answer by hand, during office hours"><bpmn:incoming>F_s1_s2</bpmn:incoming><bpmn:outgoing>F_s2_s3</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="s3" name="Hold the unit, build the reservation file"><bpmn:incoming>F_s2_s3</bpmn:incoming><bpmn:outgoing>F_s3_j1</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="j1" name="Draft the contract from the template"><bpmn:incoming>F_s3_j1</bpmn:incoming><bpmn:outgoing>F_j1_j2</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="j2" name="Chase missing documents"><bpmn:incoming>F_j1_j2</bpmn:incoming><bpmn:outgoing>F_j2_j3</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="j3" name="Sign at the register the sale with the DLD (Oqood)"><bpmn:incoming>F_j2_j3</bpmn:incoming><bpmn:outgoing>F_j3_g1</bpmn:outgoing></bpmn:manualTask>
<bpmn:parallelGateway id="g1" name=""><bpmn:incoming>F_j3_g1</bpmn:incoming><bpmn:outgoing>F_g1_f1</bpmn:outgoing><bpmn:outgoing>F_g1_rc1</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:callActivity id="f1" name="Collect each milestone (see zoom)"><bpmn:incoming>F_g1_f1</bpmn:incoming><bpmn:outgoing>F_f1_g2</bpmn:outgoing><bpmn:standardLoopCharacteristics id="LP_f1"/></bpmn:callActivity>
<bpmn:manualTask id="rc1" name="Email construction updates"><bpmn:incoming>F_g1_rc1</bpmn:incoming><bpmn:outgoing>F_rc1_rc2</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="rc2" name="Handle each change request, quote by quote"><bpmn:incoming>F_rc1_rc2</bpmn:incoming><bpmn:outgoing>F_rc2_g2</bpmn:outgoing></bpmn:manualTask>
<bpmn:parallelGateway id="g2" name=""><bpmn:incoming>F_f1_g2</bpmn:incoming><bpmn:incoming>F_rc2_g2</bpmn:incoming><bpmn:outgoing>F_g2_t1</bpmn:outgoing></bpmn:parallelGateway>
<bpmn:manualTask id="t1" name="Schedule handover visits one by one"><bpmn:incoming>F_g2_t1</bpmn:incoming><bpmn:outgoing>F_t1_t2</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="t2" name="List defects on paper, photos by email"><bpmn:incoming>F_t1_t2</bpmn:incoming><bpmn:outgoing>F_t2_t3</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="t3" name="Chase contractors until fixed"><bpmn:incoming>F_t2_t3</bpmn:incoming><bpmn:outgoing>F_t3_t4</bpmn:outgoing></bpmn:manualTask>
<bpmn:intermediateCatchEvent id="t4" name="Claim reported (years 1–10)"><bpmn:incoming>F_t3_t4</bpmn:incoming><bpmn:outgoing>F_t4_t5</bpmn:outgoing><bpmn:messageEventDefinition id="ED_t4"/></bpmn:intermediateCatchEvent>
<bpmn:manualTask id="t5" name="Find the file and the applicable warranty"><bpmn:incoming>F_t4_t5</bpmn:incoming><bpmn:outgoing>F_t5_t6</bpmn:outgoing></bpmn:manualTask>
<bpmn:manualTask id="t6" name="Contact contractor or insurer, follow up by email"><bpmn:incoming>F_t5_t6</bpmn:incoming><bpmn:outgoing>F_t6_t7</bpmn:outgoing></bpmn:manualTask>
<bpmn:endEvent id="t7" name="Claim closed"><bpmn:incoming>F_t6_t7</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F_s1_s2" sourceRef="s1" targetRef="s2"/>
<bpmn:sequenceFlow id="F_s2_s3" sourceRef="s2" targetRef="s3"/>
<bpmn:sequenceFlow id="F_s3_j1" sourceRef="s3" targetRef="j1"/>
<bpmn:sequenceFlow id="F_j1_j2" sourceRef="j1" targetRef="j2"/>
<bpmn:sequenceFlow id="F_j2_j3" sourceRef="j2" targetRef="j3"/>
<bpmn:sequenceFlow id="F_j3_g1" sourceRef="j3" targetRef="g1"/>
<bpmn:sequenceFlow id="F_g1_f1" sourceRef="g1" targetRef="f1"/>
<bpmn:sequenceFlow id="F_g1_rc1" sourceRef="g1" targetRef="rc1"/>
<bpmn:sequenceFlow id="F_rc1_rc2" sourceRef="rc1" targetRef="rc2"/>
<bpmn:sequenceFlow id="F_f1_g2" sourceRef="f1" targetRef="g2"/>
<bpmn:sequenceFlow id="F_rc2_g2" sourceRef="rc2" targetRef="g2"/>
<bpmn:sequenceFlow id="F_g2_t1" sourceRef="g2" targetRef="t1"/>
<bpmn:sequenceFlow id="F_t1_t2" sourceRef="t1" targetRef="t2"/>
<bpmn:sequenceFlow id="F_t2_t3" sourceRef="t2" targetRef="t3"/>
<bpmn:sequenceFlow id="F_t3_t4" sourceRef="t3" targetRef="t4"/>
<bpmn:sequenceFlow id="F_t4_t5" sourceRef="t4" targetRef="t5"/>
<bpmn:sequenceFlow id="F_t5_t6" sourceRef="t5" targetRef="t6"/>
<bpmn:sequenceFlow id="F_t6_t7" sourceRef="t6" targetRef="t7"/>
</bpmn:process>
