<bpmn:sequenceFlow id="F_h60_h61" sourceRef="h60" targetRef="h61"/>
<bpmn:sequenceFlow id="F_h61_h62" sourceRef="h61" targetRef="h62"/>
<bpmn:sequenceFlow id="F_h62_h63" name="new plan" sourceRef="h62" targetRef="h63"/>
<bpmn:sequenceFlow id="F_h62_h64" name="default" sourceRef="h62" targetRef="h64"/>
<bpmn:sequenceFlow id="F_h64_h65" sourceRef="h64" targetRef="h65"/>
<bpmn:sequenceFlow id="F_h65_h66" sourceRef="h65" targetRef="h66"/>
<bpmn:sequenceFlow id="F_hSP_h70" sourceRef="hSP" targetRef="h70"/>
<bpmn:sequenceFlow id="F_h70_h71" sourceRef="h70" targetRef="h71"/>
<bpmn:sequenceFlow id="F_h71_h72" sourceRef="h71" targetRef="h72"/>
</bpmn:process>
